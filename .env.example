# ============================================================
# ตัวอย่าง environment variables — คัดลอกเป็น .env.local สำหรับรันเครื่องตัวเอง
# และตั้งค่าเดียวกันนี้บน Vercel → Settings → Environment Variables
#
# ไฟล์ .env.local อยู่ใน .gitignore แล้ว ห้าม commit ค่าจริงเด็ดขาด
# ถ้าเผลอ commit key ลง git ให้ถือว่า key นั้นตายแล้ว ต้อง revoke แล้วออกใหม่
# ============================================================

# --- Omise (Opn Payments) ---
OMISE_SECRET_KEY=skey_test_xxxxxxxxxxxxxxxxxxxx
OMISE_PUBLIC_KEY=pkey_test_xxxxxxxxxxxxxxxxxxxx

# --- Supabase ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxx

# --- อีเมล (เริ่มใช้จริงรอบ 3B) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# --- ทั่วไป ---
APP_BASE_URL=https://vinko-quest.vercel.app

# วันหมดช่วงราคาเปิดตัว ตัดสินฝั่ง server เท่านั้น
# เว้นว่าง = ยังอยู่ในช่วงราคาเปิดตัว
LAUNCH_PROMO_END=

# กำหนดส่งนิทาน 5 เรื่อง คั่นด้วยจุลภาค เว้นว่างได้ถ้ายังไม่กำหนด
STORY_DELIVERY_DATES=

# salt สำหรับ hash IP ตั้งเป็นค่าสุ่มยาวๆ แล้วอย่าเปลี่ยนอีก
IP_HASH_SALT=
