# ============================================================
# ตัวอย่าง environment variables — คัดลอกเป็น .env.local สำหรับรันเครื่องตัวเอง
# และตั้งค่าเดียวกันนี้บน Vercel → Settings → Environment Variables
#
# ไฟล์ .env.local อยู่ใน .gitignore แล้ว ห้าม commit ค่าจริงเด็ดขาด
# ถ้าเผลอ commit key ลง git ให้ถือว่า key นั้นตายแล้ว ต้อง revoke แล้วออกใหม่
# ============================================================

# --- Omise (Opn Payments) ---
OMISE_SECRET_KEY=skey_test_xxxxxxxxxxxxxxxxxxxx
OMISE_PUBLIC_KEY=pkey_test_xxxxxxxxxxxxxxxxxxxx

# --- Supabase ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# กุญแจฝั่ง server รองรับ 2 รูปแบบ โค้ดไม่ต้องแก้ สลับได้เลย
#
#   แบบใหม่ (แนะนำ)  sb_secret_xxxxxxxx
#     Settings -> API Keys -> แท็บ API Keys -> Create new API keys -> ส่วน Secret keys
#     ข้อดี: สร้างหลายใบและเพิกถอนทีละใบได้ ถ้าใบไหนหลุดก็ปิดเฉพาะใบนั้น
#
#   แบบเดิม          eyJxxxxxxxx (service_role JWT)
#     Supabase จะเลิกรองรับภายในสิ้นปี 2026 และเพิกถอนทีละใบไม่ได้
#     ถ้าหลุดต้องหมุนทั้งชุด ทุกอย่างที่ใช้อยู่จะพังพร้อมกัน
#
# การสร้าง key ชุดใหม่ไม่ได้เพิกถอนของเดิม ใช้พร้อมกันได้ระหว่างทดสอบ
# ทดสอบว่า key ใช้ได้จริงก่อนขึ้น Vercel:  node tests/supabase-smoke.js
#
# อย่าเอา sb_publishable_ หรือ anon key มาใส่ช่องนี้ โค้ดจะปฏิเสธทันที
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# --- อีเมล (เริ่มใช้จริงรอบ 3B) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# --- ทั่วไป ---
APP_BASE_URL=https://vinko-quest.vercel.app

# วันหมดช่วงราคาเปิดตัว ตัดสินฝั่ง server เท่านั้น
# เว้นว่าง = ยังอยู่ในช่วงราคาเปิดตัว
LAUNCH_PROMO_END=

# กำหนดส่งนิทาน 5 เรื่อง คั่นด้วยจุลภาค เว้นว่างได้ถ้ายังไม่กำหนด
STORY_DELIVERY_DATES=

# salt สำหรับ hash IP ตั้งเป็นค่าสุ่มยาวๆ แล้วอย่าเปลี่ยนอีก
IP_HASH_SALT=
